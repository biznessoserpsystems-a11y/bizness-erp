# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Set to "true" only when the frontend is genuinely on a different
# domain than this API (e.g. GitHub Pages serving the frontend, this
# server on Render) - required for the login-refresh cookie to work
# across that split at all. Leave unset/false when frontend and backend
# share a domain; Strict is the safer default and should stay in place
# unless this specific cross-domain shape is actually what you're
# deploying.
COOKIE_CROSS_SITE=false

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bizness_os

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Security
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15
